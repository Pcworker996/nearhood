{
  "name": "nearhood",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "db:setup": "tsx scripts/setup-database.ts",
    "model:check": "tsx scripts/check-report-model.ts",
    "matching:live": "node --import tsx scripts/check-matching-live.ts",
    "test:matching": "node --import tsx --test scripts/matching-evaluation.test.ts",
    "test:model": "node --import tsx --test scripts/check-report-model.test.ts",
    "test:extraction": "node --import tsx --test scripts/extract-report-output.test.ts scripts/live-category.test.ts",
    "test:review-set": "node --import tsx --test scripts/review-set.test.ts",
    "test:lease": "node --import tsx --test scripts/report-lease.test.ts",
    "extraction:live": "node --import tsx scripts/check-extraction-live.ts",
    "test": "playwright test",
    "test:browse": "playwright test tests/browse.spec.ts",
    "verify": "bash scripts/verify-local.sh"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.3",
    "leaflet": "1.9.4",
    "next": "16.4.0",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-leaflet": "5.0.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
