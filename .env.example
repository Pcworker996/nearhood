# Server-only PostgreSQL connection. Use the Supabase session pooler on a persistent
# Node host, or its transaction pooler for serverless deployment (no prepared statements).
DATABASE_URL=postgresql://127.0.0.1:55432/nearhood

# Remote database connections use verified TLS. Download the Supabase root CA
# from Database Settings > SSL Configuration > Download Certificate.
# Locally, set the path to that file. On Vercel, set DATABASE_SSL_CA to its PEM
# contents (real newlines or literal \n). Inline contents take precedence.
# Use these settings for TLS; remote URL SSL parameters cannot override them.
# db:setup reads environment variables from the shell, not .env.local.
DATABASE_SSL_CA_FILE=
DATABASE_SSL_CA=

# Public MapTiler browser key; restrict it to your localhost and deployed domains.
NEXT_PUBLIC_MAPTILER_KEY=

# Google-only Supabase Auth. Enable Google in the Supabase dashboard and register
# APP_ORIGIN/auth/callback as an allowed redirect. These are used by server routes;
# no service-role key is required. Keep the canonical origin consistent with the
# browser URL so the PKCE verifier and local draft remain on the same origin.
APP_ORIGIN=http://127.0.0.1:3000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only Nebius Token Factory integration. Run npm run model:check with a
# real key, inspect .local/report-model-check.json, then set its selected exact
# NVIDIA Nemotron identifier here. An unset model safely leaves Reports pending.
NEBIUS_API_KEY=
NEBIUS_MODEL=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
